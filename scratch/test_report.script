
Create Spacecraft Sat;
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '09 Mar 1960 05:40:58.231';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Cartesian;
Sat.X = 6134.844780;
Sat.Y = -979.508241;
Sat.Z = -2112.127488;
Sat.VX = 2.069625;
Sat.VY = 6.998363;
Sat.VZ = 2.754849;

Create ReportFile EarthInertialView;
EarthInertialView.Filename = 'EarthInertialView.txt';
EarthInertialView.WriteHeaders = false;

Create ForceModel LEOPropForceModel;
LEOPropForceModel.CentralBody = Earth;
LEOPropForceModel.PointMasses = {Earth};
Create Propagator LEOProp;
LEOProp.FM = LEOPropForceModel;
LEOProp.Type = RungeKutta89;

BeginMissionSequence;

Propagate LEOProp(Sat) {Sat.ElapsedSecs = 100};

Report EarthInertialView Sat.ElapsedSecs Sat.X Sat.Y Sat.Z Sat.VX Sat.VY Sat.VZ Sat.Earth.Altitude Sat.SMA Sat.ECC Sat.INC Sat.RAAN Sat.AOP Sat.TA Sat.Earth.RMAG Sat.TotalMass;
