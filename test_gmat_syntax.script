
Create Spacecraft Sat;
Create Propagator LEOProp;
Create DifferentialCorrector DC;
Create ImpulsiveBurn Burn1;
BeginMissionSequence;
Target DC;
   Vary DC(Burn1.Element1 = 1.0, {Upper = 5.0, Lower = -5.0, MaxStep = 0.5});
   Maneuver Burn1(Sat);
   Propagate LEOProp(Sat) {Sat.Earth.Apoapsis};
   Achieve DC(Sat.Earth.SMA = 42164.14, {Tolerance = 0.1});
EndTarget;
