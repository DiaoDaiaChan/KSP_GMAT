
Create Spacecraft Sat;
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '08 Mar 1960 20:16:20.396';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Cartesian;
Sat.X = -3271.22;
Sat.Y = 4789.28;
Sat.Z = 3088.00;
Sat.VX = -6.60;
Sat.VY = -4.07;
Sat.VZ = -0.66;
Sat.DryMass = 1500;

Create Variable v1 v2 v3 m0 m1 isp g0 dv;
m0 = 5000;
m1 = 2500;
isp = 464.8;
g0 = 9.80665;

BeginMissionSequence;
dv = isp * g0 * ln(m0 / m1);
Write dv;
