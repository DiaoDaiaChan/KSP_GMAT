## KSP_GMAT .gitignore

# Build results (.NET)
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.binlog
*.user
*.suo
*.userprefs
.vs/
.idea/

# NuGet Packages
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.pytest_cache/

# Node / Frontend
node_modules/
dist/
.cache/

# GMAT Output & Logs (Strip runtime calculations)
output/
*.report
mission_traj.txt
mission_run.script
gmat_orbit_render.png
*.log

# Strip GMAT Official Binaries & Clutter
*.exe
*.dll.old
*.old.dll
*.pdb
*.obj
*.exp
*.lib
*.ilk
GMAT.ini
gmat_startup_file.txt
osgPlugins-*/
gmatpy/
principia-src/

# Scratch & temporary exploratory code
scratch/
scratch_*.txt
temp_*.script
*.script.tmp

# Allow GameData Release DLL
!GameData/KSPGMAT/Plugins/KSPGMAT.dll

# Native build outputs
build_kep3/
console_out.txt

pykep_sourcecode/
.trae/
