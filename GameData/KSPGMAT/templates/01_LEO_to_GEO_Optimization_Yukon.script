% -------------------------------------------------------------
% NASA GMAT Mission Script - LEO to GEO Trajectory Optimization
% Generated by KSP_GMAT Pure C# Engine (Yukon SQP Optimizer)
% -------------------------------------------------------------
Create Spacecraft Sat;
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '09 Mar 1960 03:27:47.591';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Cartesian;
Sat.X = -5337.197780;
Sat.Y = -3080.395825;
Sat.Z = 2280.468724;
Sat.VX = 2.828285;
Sat.VY = -6.791792;
Sat.VZ = -2.559760;
Sat.DryMass = 1477.96;
Sat.DragArea = 15.00;
Sat.Cd = 2.20;
Sat.Cr = 1.80;
Sat.SRPArea = 1.00;

Create ChemicalTank Tank0;
Tank0.AllowNegativeFuelMass = true;
Tank0.FuelMass = 61.32;
Tank0.Volume = 10.00;
Tank0.PressureModel = 'PressureRegulated';

Create ChemicalTank Tank1;
Tank1.AllowNegativeFuelMass = true;
Tank1.FuelMass = 6282.90;
Tank1.Volume = 62.83;
Tank1.PressureModel = 'PressureRegulated';

Create ChemicalThruster RL10SeriesNonExtendableNozzle;
RL10SeriesNonExtendableNozzle.CoordinateSystem = Local;
RL10SeriesNonExtendableNozzle.Origin = Earth;
RL10SeriesNonExtendableNozzle.Axes = VNB;
RL10SeriesNonExtendableNozzle.ThrustDirection1 = 1;
RL10SeriesNonExtendableNozzle.ThrustDirection2 = 0;
RL10SeriesNonExtendableNozzle.ThrustDirection3 = 0;
RL10SeriesNonExtendableNozzle.DecrementMass = true;
RL10SeriesNonExtendableNozzle.Tank = {Tank1};
RL10SeriesNonExtendableNozzle.C1 = 108100.00;
RL10SeriesNonExtendableNozzle.K1 = 464.80;

Sat.Tanks = {Tank0, Tank1};
Sat.Thrusters = {RL10SeriesNonExtendableNozzle};

Create FiniteBurn GTO_Burn;
GTO_Burn.Thrusters = {RL10SeriesNonExtendableNozzle};
GTO_Burn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn GEO_Burn;
GEO_Burn.Thrusters = {RL10SeriesNonExtendableNozzle};
GEO_Burn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create ForceModel LEO_ForceModel;
LEO_ForceModel.CentralBody = Earth;
LEO_ForceModel.PointMasses = {Earth};

Create Propagator LEOProp;
LEOProp.FM = LEO_ForceModel;
LEOProp.Type = PrinceDormand78;

Create Yukon Yukon1;
Yukon1.ShowProgress = true;
Yukon1.ReportStyle = Normal;
Yukon1.MaximumIterations = 50;
Yukon1.FeasibilityTolerance = 0.001;
Yukon1.OptimalityTolerance = 0.001;

Create Variable GTO_Duration GEO_Duration TotalBurnTime;
TotalBurnTime = 0;

Create ReportFile TrajReport;
TrajReport.Filename = 'TrajReport.txt';
TrajReport.WriteHeaders = false;

% -------------------------------------------------------------
% GMAT Mission Sequence Execution Control: SQP Optimization
% -------------------------------------------------------------
BeginMissionSequence;

% 1. Coast to Equatorial Ascending Node (Latitude = 0)
Propagate LEOProp(Sat) {Sat.Earth.Latitude = 0.0};

% 2. Open Global Yukon SQP Optimization Sequence
Optimize Yukon1 {SolveMode = Solve, ExitMode = SaveAndContinue};
   % Vary Variable 1: GTO Injection Burn Duration
   Vary Yukon1(GTO_Duration = 120.0, {Perturbation = 0.001, Lower = 20, Upper = 300, MaxStep = 10});
   
   BeginFiniteBurn GTO_Burn(Sat);
   Propagate LEOProp(Sat) {Sat.ElapsedSecs = GTO_Duration};
   EndFiniteBurn GTO_Burn(Sat);
   
   % Transfer Coast to Apoapsis
   Propagate LEOProp(Sat) {Sat.Earth.Apoapsis};
   
   % Vary Variables 2 & 3: GEO Circularization Duration & Thrust Pitch Angle
   Vary Yukon1(GEO_Duration = 65.0, {Perturbation = 0.001, Lower = 10, Upper = 200, MaxStep = 5});
   Vary Yukon1(Sat.RL10SeriesNonExtendableNozzle.ThrustDirection2 = 0.5, {Perturbation = 0.001, Lower = -2.0, Upper = 2.0, MaxStep = 0.1});
   
   BeginFiniteBurn GEO_Burn(Sat);
   Propagate LEOProp(Sat) {Sat.ElapsedSecs = GEO_Duration};
   EndFiniteBurn GEO_Burn(Sat);
   
   % Cost Function: Minimize Total Engine Burn Time
   TotalBurnTime = GTO_Duration + GEO_Duration;
   Minimize Yukon1(TotalBurnTime);
   
   % Physical Equality & Inequality Orbital Constraints
   NonlinearConstraint Yukon1(Sat.Earth.SMA = 42164.14);
   NonlinearConstraint Yukon1(Sat.Earth.ECC <= 0.005);
   NonlinearConstraint Yukon1(Sat.EarthMJ2000Eq.INC <= 0.1);
EndOptimize;

% Telemetry Export
Report TrajReport Sat.ElapsedSecs Sat.X Sat.Y Sat.Z Sat.VX Sat.VY Sat.VZ Sat.Earth.Altitude Sat.SMA Sat.ECC Sat.INC Sat.TotalMass;
