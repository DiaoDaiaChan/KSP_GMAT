%----------------------------------------------------------------------
% GMAT Official Standard Template: Earth-Moon NRHO (Gateway Halo Orbit)
% Cislunar Transfer -> Lunar L2 Southern Halo NRHO Insertion & 21-Day Stationkeeping
%----------------------------------------------------------------------

Create Spacecraft Sat;
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '15 Jul 2026 00:00:00.000';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Keplerian;
Sat.SMA = 6578.14;
Sat.ECC = 0.001;
Sat.INC = 28.5;
Sat.RAAN = 0.0;
Sat.AOP = 0.0;
Sat.TA = 0.0;
Sat.DryMass = 4000.0;

Create ChemicalTank ServiceTank;
ServiceTank.AllowNegativeFuelMass = true;
ServiceTank.FuelMass = 6000.0;
ServiceTank.Volume = 10.0;
ServiceTank.PressureModel = 'PressureRegulated';

Create ChemicalThruster OMM_Engine;
OMM_Engine.CoordinateSystem = Local;
OMM_Engine.Origin = Earth;
OMM_Engine.Axes = VNB;
OMM_Engine.ThrustDirection1 = 1.0;
OMM_Engine.ThrustDirection2 = 0.0;
OMM_Engine.ThrustDirection3 = 0.0;
OMM_Engine.DutyCycle = 1.0;
OMM_Engine.ThrustScaleFactor = 1.0;
OMM_Engine.DecrementMass = true;
OMM_Engine.Tank = {ServiceTank};
OMM_Engine.GravitationalAccel = 9.80665;
OMM_Engine.C1 = 15000.0;
OMM_Engine.C2 = 0.0;
OMM_Engine.K1 = 320.0;
OMM_Engine.K2 = 0.0;

Sat.Tanks = {ServiceTank};
Sat.Thrusters = {OMM_Engine};

Create ForceModel Cislunar_ForceModel;
Cislunar_ForceModel.CentralBody = Earth;
Cislunar_ForceModel.PointMasses = {Earth, Luna, Sun};
Cislunar_ForceModel.Drag = None;
Cislunar_ForceModel.SRP = Off;

Create Propagator CislunarProp;
CislunarProp.FM = Cislunar_ForceModel;
CislunarProp.Type = RungeKutta89;
CislunarProp.InitialStepSize = 60.0;
CislunarProp.Accuracy = 1e-10;
CislunarProp.MinStep = 0.0;
CislunarProp.MaxStep = 2700.0;

Create FiniteBurn NRHO_InsertionBurn;
NRHO_InsertionBurn.Thrusters = {OMM_Engine};

Create DifferentialCorrector DC_NRHO;
DC_NRHO.ShowProgress = true;
DC_NRHO.DerivativeMethod = ForwardDifference;
DC_NRHO.Algorithm = NewtonRaphson;
DC_NRHO.MaximumIterations = 50;

Create Variable Insertion_Duration;
Insertion_Duration = 220.0;

Create ReportFile TrajReport;
TrajReport.Filename = 'NRHO_Halo_Traj.txt';
TrajReport.WriteHeaders = false;

BeginMissionSequence;

% Step 1: LEO Parking Orbit Coast
Propagate CislunarProp(Sat) {Sat.ElapsedSecs = 1200.0};

% Step 2: Target NRHO Transfer Injection
Target DC_NRHO {SolveMode = Solve, ExitMode = SaveAndContinue};
  Vary DC_NRHO(Insertion_Duration = 220.0, {Perturbation = 0.0001, Lower = 50.0, Upper = 600.0, MaxStep = 5.0});
  BeginFiniteBurn NRHO_InsertionBurn(Sat);
  Propagate CislunarProp(Sat) {Sat.ElapsedSecs = Insertion_Duration};
  EndFiniteBurn NRHO_InsertionBurn(Sat);
  Propagate CislunarProp(Sat) {Sat.Earth.Apoapsis};
  Achieve DC_NRHO(Sat.Earth.Altitude = 380000.0, {Tolerance = 100.0});
EndTarget;

% Step 3: 5-Day Cislunar Transfer Cruise
Propagate CislunarProp(Sat) {Sat.ElapsedDays = 5.0};

% Step 4: 21-Day Multi-Revolution NRHO Stationkeeping Simulation
Propagate CislunarProp(Sat) {Sat.ElapsedDays = 21.0};
Report TrajReport Sat.ElapsedSecs Sat.X Sat.Y Sat.Z Sat.VX Sat.VY Sat.VZ Sat.TotalMass;
