% -------------------------------------------------------------
% NASA GMAT Mission Script - Optimized Earth-to-Moon TLI
% Window: ~46 minutes (2760s) from LEO
% -------------------------------------------------------------

Create Spacecraft Sat;
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '09 Mar 1960 15:31:53.718';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Cartesian;
Sat.X = -6333.594893;
Sat.Y = 475.232718;
Sat.Z = -1664.300893;
Sat.VX = 0.303173;
Sat.VY = -7.121470;
Sat.VZ = -3.158465;
Sat.DryMass = 1477.955886;
Sat.DragArea = 15;
Sat.Cd = 2.2;
Sat.Cr = 1.8;
Sat.SRPArea = 12;

Create ChemicalTank Tank0;
Tank0.AllowNegativeFuelMass = true;
Tank0.FuelMass = 61.324457;
Tank0.Volume = 0.641302;
Tank0.FuelDensity = 1000;
Tank0.PressureModel = 'PressureRegulated';

Create ChemicalTank Tank1;
Tank1.AllowNegativeFuelMass = true;
Tank1.FuelMass = 6282.721114;
Tank1.Volume = 31.8086328;
Tank1.FuelDensity = 1000;
Tank1.PressureModel = 'PressureRegulated';

Create ChemicalThruster RL10SeriesNonExtendableNozzle;
RL10SeriesNonExtendableNozzle.CoordinateSystem = Local;
RL10SeriesNonExtendableNozzle.Origin = Earth;
RL10SeriesNonExtendableNozzle.Axes = VNB;
RL10SeriesNonExtendableNozzle.ThrustDirection1 = 1;
RL10SeriesNonExtendableNozzle.ThrustDirection2 = 0;
RL10SeriesNonExtendableNozzle.ThrustDirection3 = 0;
RL10SeriesNonExtendableNozzle.DecrementMass = true;
RL10SeriesNonExtendableNozzle.Tank = {Tank1};
RL10SeriesNonExtendableNozzle.C1 = 108099.998474121;
RL10SeriesNonExtendableNozzle.K1 = 464.799987792969;

Sat.Tanks = {Tank0, Tank1};
Sat.Thrusters = {RL10SeriesNonExtendableNozzle};

Create FiniteBurn FiniteBurn_TLI;
FiniteBurn_TLI.Thrusters = {RL10SeriesNonExtendableNozzle};
FiniteBurn_TLI.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create ForceModel LEOPropForceModel;
LEOPropForceModel.CentralBody = Earth;
LEOPropForceModel.PointMasses = {Earth, Luna, Sun};
LEOPropForceModel.SRP = On;

Create Propagator LEOProp;
LEOProp.FM = LEOPropForceModel;
LEOProp.Type = RungeKutta89;
LEOProp.InitialStepSize = 30.0;
LEOProp.Accuracy = 1E-11;
LEOProp.MinStep = 0.001;
LEOProp.MaxStep = 300.0;

Create ForceModel CislunarPropForceModel;
CislunarPropForceModel.CentralBody = Earth;
CislunarPropForceModel.PointMasses = {Earth, Luna, Sun};
CislunarPropForceModel.SRP = On;

Create Propagator CislunarProp;
CislunarProp.FM = CislunarPropForceModel;
CislunarProp.Type = RungeKutta89;
CislunarProp.InitialStepSize = 60.0;
CislunarProp.Accuracy = 1E-11;
CislunarProp.MinStep = 0.001;
CislunarProp.MaxStep = 2700.0;

Create DifferentialCorrector DC_TLI;
DC_TLI.ShowProgress = true;
DC_TLI.DerivativeMethod = ForwardDifference;
DC_TLI.Algorithm = NewtonRaphson;
DC_TLI.MaximumIterations = 50;

Create Variable Coast_Time;
Coast_Time = 2760.0;
Create Variable Burn_Duration;
Burn_Duration = 165.0;

Create ReportFile TrajReport;
TrajReport.Filename = 'TrajReport.txt';
TrajReport.WriteHeaders = true;

BeginMissionSequence;

% Target Moon periapsis around 46m window
Target DC_TLI {SolveMode = Solve, ExitMode = DiscardAndContinue};
    % 1. Vary coast time around the 46m (2760s) window
    Vary DC_TLI(Coast_Time = 2760.0, {Perturbation = 1.0, Lower = 2400.0, Upper = 3100.0, MaxStep = 50.0});
    
    % 2. Vary burn duration (around 165 seconds for RL-10)
    Vary DC_TLI(Burn_Duration = 165.0, {Perturbation = 0.1, Lower = 120.0, Upper = 220.0, MaxStep = 5.0});
    
    % 3. Vary out-of-plane thrust vector component
    Vary DC_TLI(Sat.RL10SeriesNonExtendableNozzle.ThrustDirection2 = 0.0, {Perturbation = 0.0001, Lower = -0.3, Upper = 0.3, MaxStep = 0.05});

    % Execute Coast
    Propagate LEOProp(Sat) {Sat.ElapsedSecs = Coast_Time};
    
    % Execute Finite Burn
    BeginFiniteBurn FiniteBurn_TLI(Sat);
    Propagate LEOProp(Sat) {Sat.ElapsedSecs = Burn_Duration};
    EndFiniteBurn FiniteBurn_TLI(Sat);
    
    % Coast to Moon Periapsis
    Propagate CislunarProp(Sat) {Sat.Luna.Periapsis};
    
    % Target Lunar Periapsis Radius ~ 1838 km (100 km altitude above surface)
    Achieve DC_TLI(Sat.Luna.RadPer = 1838.0, {Tolerance = 50.0});
EndTarget;

Report TrajReport Sat.Luna.RadPer Sat.Luna.Altitude Sat.TotalMass;
